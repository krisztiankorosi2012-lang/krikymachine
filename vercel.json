{
  "version": 2,
  "rewrites": [
    { "source": "/ask", "destination": "/api/ask" },
    { "source": "/ping", "destination": "/api/ping" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
